# Git attributes for the whole repository.
#
# Line endings: source and prose are LF in the repository and in every
# checkout. Only the listed kinds are normalised; test data keeps its bytes
# (some fixtures are CRLF on purpose), so there is no `* text=auto`.
*.rs            text eol=lf
*.toml          text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.mts           text eol=lf
*.js            text eol=lf
*.jsx           text eol=lf
*.mjs           text eol=lf
*.cjs           text eol=lf
*.json          text eol=lf
*.jsonc         text eol=lf
*.json5         text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.sh            text eol=lf
*.py            text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.wgsl          text eol=lf
*.svg           text eol=lf
*.lock          text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.prettierignore text eol=lf
.prototools     text eol=lf

# Test data whose bytes are the test: never converted.
*.csv           -text
*.tsv           -text

# Binary: no text conversion, no textual diff.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.jxl   binary
*.tif   binary
*.tiff  binary
*.exr   binary
*.hdr   binary
*.psd   binary
*.psb   binary
*.ai    binary
*.eps   binary
*.ase   binary
*.abr   binary
*.icc   binary
*.v     binary
*.pdf   binary
*.idml  binary
*.paged binary
*.docx  binary
*.docm  binary
*.dotx  binary
*.odt   binary
*.xlsx  binary
*.pptx  binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.wasm  binary
*.zip   binary
*.parquet binary
*.onnx  binary
*.bin   binary

