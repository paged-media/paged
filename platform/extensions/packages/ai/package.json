{
  "name": "@paged-media/ai",
  "version": "0.1.0-canary.4",
  "description": "Claude for paged: the authoring prompt, the script tools, the generate \u2192 run \u2192 verify \u2192 correct loop, and the transports (direct key or the same-origin proxy).",
  "license": "AGPL-3.0-only OR LicenseRef-PMEL",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./proxy": "./src/proxy.ts",
    "./catalog": "./src/engine-catalog.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --parallel --preload ../../../../tooling/js/bun-test-setup.ts",
    "build": "tsup src/index.ts src/proxy.ts src/engine-catalog.ts --format esm --target es2020 --dts --out-dir dist --clean",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0"
  },
  "devDependencies": {
    "@paged-media/plugin-api": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "@types/bun": "catalog:"
  },
  "files": [
    "dist",
    "assets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paged-media/paged.git",
    "directory": "platform/extensions/packages/ai"
  },
  "publishConfig": {
    "access": "public",
    "tag": "canary",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./proxy": {
        "types": "./dist/proxy.d.ts",
        "default": "./dist/proxy.js"
      },
      "./catalog": {
        "types": "./dist/engine-catalog.d.ts",
        "default": "./dist/engine-catalog.js"
      }
    }
  },
  "peerDependencies": {
    "@paged-media/plugin-api": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@paged-media/plugin-api": {
      "optional": true
    }
  }
}
