{
  "name": "@paged-media/plugin-sdk",
  "version": "0.74.3-canary.16",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./gesture-kit": "./src/gesture-kit.ts",
    "./api": "./src/api.ts"
  },
  "scripts": {
    "typecheck": "bun check -p tsconfig.json",
    "test": "bun test --timeout 30000 --parallel --preload ../../../../tooling/js/bun-test-setup.ts",
    "build": "bun scripts/build.mjs && tsc -p tsconfig.build.json && bun scripts/inline-api.mjs",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@types/react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@paged-media/canvas-wasm": "workspace:*",
    "@paged-media/plugin-api": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "fast-check": "^4.10.2",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "description": "The Paged extension SDK: the contract, type-only, as ./api; the runtime (loadBundle, the in-process BundleHost adapter, the gesture kit, the headless host, version negotiation); and the paged-plugin CLI (scaffold a plugin, validate a manifest, stamp and host its wasm).",
  "license": "AGPL-3.0-only OR LicenseRef-PMEL",
  "bin": {
    "paged-plugin": "./bin/paged-plugin.mjs"
  },
  "files": [
    "dist",
    "bin",
    "untyped-commands.baseline.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paged-media/paged.git",
    "directory": "platform/extensions/packages/plugin-sdk"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./gesture-kit": {
        "types": "./dist/gesture-kit.d.ts",
        "default": "./dist/gesture-kit.js"
      },
      "./api": {
        "types": "./dist/api/index.d.ts",
        "default": "./dist/api/index.js"
      },
      "./api/manifest.schema.json": "./dist/api/manifest.schema.json",
      "./package.json": "./package.json"
    }
  }
}
