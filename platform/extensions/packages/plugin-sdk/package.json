{
  "name": "@paged-media/plugin-sdk",
  "version": "0.2.75-canary.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "bun check -p tsconfig.json",
    "test": "bun test --parallel --preload ../../../../tooling/js/bun-test-setup.ts",
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --format esm --target node --packages external && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@paged-media/plugin-api": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@paged-media/canvas-wasm": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "fast-check": "^4.10.2",
    "react": "catalog:",
    "typescript": "catalog:",
    "@types/bun": "catalog:"
  },
  "description": "The Paged plugin runtime: loadBundle, the in-process BundleHost adapter, the gesture kit, and version negotiation; and the paged-plugin CLI (validate a manifest, stamp and host its wasm).",
  "license": "AGPL-3.0-only OR LicenseRef-PMEL",
  "bin": {
    "paged-plugin": "./bin/paged-plugin.mjs"
  },
  "files": [
    "dist",
    "bin",
    "untyped-commands.baseline.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paged-media/paged.git",
    "directory": "platform/extensions/packages/plugin-sdk"
  },
  "publishConfig": {
    "access": "public",
    "tag": "canary",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
