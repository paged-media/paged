{
  "name": "@paged-media/cli",
  "version": "0.1.0-canary.0",
  "description": "The paged Node CLI: get/set/query/schema/batch/run/export/apply/merge over core and every installed plugin bundle, through the headless host (ADR 324).",
  "license": "MPL-2.0 OR LicenseRef-PMEL",
  "type": "module",
  "bin": {
    "paged": "./dist/bin.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "runtime"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@paged-media/canvas-wasm": "0.71.2"
  },
  "peerDependencies": {
    "@duckdb/duckdb-wasm": "1.29.0"
  },
  "peerDependenciesMeta": {
    "@duckdb/duckdb-wasm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "1.29.0",
    "@paged-media/ai": "workspace:*",
    "@paged-media/data": "0.1.0-canary.10",
    "@paged-media/plugin-api": "workspace:*",
    "@paged-media/plugin-sdk": "workspace:*",
    "@types/node": "20.19.39",
    "react": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paged-media/plugin-sdk.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "tag": "canary",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
