{
  "name": "@paged-media/idml-viewer",
  "version": "0.74.0-dev",
  "description": "Standalone IDML viewer for the browser: camera, pages, input and events over the engine's WebGPU ViewerSession, which ships in the package (./session).",
  "license": "AGPL-3.0-only OR LicenseRef-PMEL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paged-media/paged.git",
    "directory": "engine/core/web/idml-viewer"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./session": {
      "types": "./wasm/paged_sdk.d.ts",
      "default": "./wasm/paged_sdk.js"
    },
    "./session/paged_sdk_bg.wasm": "./wasm/paged_sdk_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "wasm/paged_sdk.js",
    "wasm/paged_sdk.d.ts",
    "wasm/paged_sdk_bg.wasm",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "bun check -p tsconfig.json",
    "test": "bun test --parallel --preload ../../../../tooling/js/bun-test-setup.ts"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/bun": "catalog:"
  }
}
