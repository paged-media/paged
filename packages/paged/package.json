{
  "name": "@paged-media/paged",
  "version": "0.74.0-dev",
  "description": "The paged engine: the editing canvas (wire types, document model, WebGPU rendering), its introspection (./introspect) and the document repository (./repo) as wasm for the browser and Node, and the `paged` command line over it, with `paged mcp` for agents.",
  "license": "AGPL-3.0-only OR LicenseRef-PMEL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paged-media/paged.git",
    "directory": "packages/paged"
  },
  "type": "module",
  "main": "paged_canvas_wasm.js",
  "types": "paged_canvas_wasm.d.ts",
  "exports": {
    ".": {
      "types": "./paged_canvas_wasm.d.ts",
      "default": "./paged_canvas_wasm.js"
    },
    "./paged_canvas_wasm_bg.wasm": "./paged_canvas_wasm_bg.wasm",
    "./paged_canvas_wasm.d.ts": "./paged_canvas_wasm.d.ts",
    "./introspect": {
      "types": "./introspect/paged_introspect_wasm.d.ts",
      "default": "./introspect/paged_introspect_wasm.js"
    },
    "./introspect/paged_introspect_wasm_bg.wasm": "./introspect/paged_introspect_wasm_bg.wasm",
    "./introspect/catalog.json": "./introspect/catalog.json",
    "./repo": {
      "types": "./repo/paged_repo_wasm.d.ts",
      "default": "./repo/paged_repo_wasm.js"
    },
    "./repo/paged_repo_wasm_bg.wasm": "./repo/paged_repo_wasm_bg.wasm",
    "./package.json": "./package.json"
  },
  "bin": {
    "paged": "./dist/paged.js"
  },
  "files": [
    "paged_canvas_wasm.js",
    "paged_canvas_wasm_bg.wasm",
    "paged_canvas_wasm.d.ts",
    "introspect/paged_introspect_wasm.js",
    "introspect/paged_introspect_wasm_bg.wasm",
    "introspect/paged_introspect_wasm.d.ts",
    "introspect/catalog.json",
    "repo/paged_repo_wasm.js",
    "repo/paged_repo_wasm_bg.wasm",
    "repo/paged_repo_wasm.d.ts",
    "dist/paged.js",
    "dist/THIRD-PARTY-NOTICES.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun scripts/assemble.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
