#!/usr/bin/env bash
# macOS link driver (.cargo/config.toml): Apple's ld, the system linker.
# PAGED_LINKER=lld links with the active toolchain's lld instead
# (`gcc-ld/ld64.lld`, shipped with every rustup toolchain and matched to its
# LLVM). Apple's ld is the default because it links faster: the link-only
# benchmark in docs/migration/ci-speed.md (lever 5) measured lld 1.5 to 2.6
# times slower, here and on the hosted macOS runners.
# A binary records its linker: `otool -l <bin>` shows LC_BUILD_VERSION tool 4
# for LLD, tool 3 for Apple's ld.
if [ "${PAGED_LINKER:-ld}" = lld ] && [ -n "${CARGO:-}" ]; then
  case "$(uname -m)" in
    arm64) host=aarch64-apple-darwin ;;
    *) host=x86_64-apple-darwin ;;
  esac
  lld="$(dirname "$CARGO")/../lib/rustlib/$host/bin/gcc-ld/ld64.lld"
  if [ -x "$lld" ]; then
    exec cc --ld-path="$lld" "$@"
  fi
fi
exec cc "$@"
