{
  "name": "@paged-media/draw",
  "private": false,
  "version": "0.1.0-canary.20",
  "license": "AGPL-3.0-only OR LicenseRef-PMEL",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./geometry": "./src/geometry.ts",
    "./machines": "./src/machines.ts",
    "./trace-worker": "./src/trace-worker.ts",
    "./manifest.json": "./manifest.json"
  },
  "scripts": {
    "typecheck": "bun check -p tsconfig.json",
    "test": "vitest run",
    "build": "tsup",
    "prepublishOnly": "bun run build",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "@paged-media/canvas-wasm": "workspace:*",
    "@paged-media/draw-geometry": "workspace:*",
    "@paged-media/draw-tools": "workspace:*",
    "@paged-media/plugin-api": "workspace:*",
    "@paged-media/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "^30.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "wasm",
    "manifest.json"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "canary",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./geometry": {
        "types": "./dist/geometry.d.ts",
        "default": "./dist/geometry.js"
      },
      "./machines": {
        "types": "./dist/machines.d.ts",
        "default": "./dist/machines.js"
      },
      "./trace-worker": {
        "types": "./dist/trace-worker.d.ts",
        "default": "./dist/trace-worker.js"
      },
      "./manifest.json": "./manifest.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paged-media/paged.git",
    "directory": "modules/draw/packages/draw-bundle"
  },
  "peerDependencies": {
    "@paged-media/plugin-api": "workspace:*",
    "@paged-media/plugin-sdk": "workspace:*",
    "react": "^18.3.0"
  }
}
