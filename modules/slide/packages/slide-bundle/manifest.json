{
  "id": "media.paged.slide",
  "name": "paged.slide",
  "version": "0.1.0",
  "apiVersion": "^0.2",
  "publisher": "paged.media",
  "capabilities": {
    "document": {
      "read": "broad",
      "write": "broad",
      "readNative": true,
      "openNative": true
    },
    "rendering": ["overlay"],
    "editContext": ["slideDeck", "slideChart"],
    "clipboard": "none",
    "keybindings": true,
    "assets": ["fonts"],
    "wasm": [
      {
        "name": "slide-engine",
        "path": "bin/slide_js_bg.wasm",
        "purpose": "compute",
        "maxBytes": 8388608
      }
    ],
    "documents": {
      "open": true,
      "export": true
    },
    "gpu": {
      "realm": "bundle"
    }
  },
  "contributes": {
    "commands": [
      "media.paged.slide.command.newSlide",
      "media.paged.slide.command.duplicateSlide",
      "media.paged.slide.command.deleteSlide",
      "media.paged.slide.command.moveSlideUp",
      "media.paged.slide.command.moveSlideDown",
      "media.paged.slide.command.importPptx",
      "media.paged.slide.command.exportPptx",
      "media.paged.slide.command.previousSlide",
      "media.paged.slide.command.nextSlide",
      "media.paged.slide.command.addComment",
      "media.paged.slide.command.slideShowFromBeginning",
      "media.paged.slide.command.slideShowFromCurrent",
      "media.paged.slide.command.presenterView",
      "media.paged.slide.command.rehearseTimings",
      "media.paged.slide.command.slideSorter",
