{
  "id": "media.paged.slide",
  "name": "paged.slide",
  "version": "0.1.0",
  "apiVersion": "^0.2",
  "publisher": "paged.media",
  "capabilities": {
    "document": {
      "read": "broad",
      "write": "broad",
      "readNative": true,
      "openNative": true
    },
    "rendering": ["overlay"],
    "editContext": ["slideDeck"],
    "clipboard": "none",
    "keybindings": true,
    "assets": ["fonts"],
    "wasm": [
      {
        "name": "slide-engine",
        "path": "bin/slide_js_bg.wasm",
        "purpose": "compute",
        "maxBytes": 8388608
      }
    ],
    "documents": {
      "open": true,
      "export": true
    },
    "gpu": {
      "realm": "bundle"
    },
    "rendering": ["overlay"]
  },
  "contributes": {
    "commands": [
      "media.paged.slide.command.newSlide",
      "media.paged.slide.command.duplicateSlide",
      "media.paged.slide.command.deleteSlide",
      "media.paged.slide.command.moveSlideUp",
      "media.paged.slide.command.moveSlideDown",
      "media.paged.slide.command.importPptx",
      "media.paged.slide.command.exportPptx",
      "media.paged.slide.command.previousSlide",
      "media.paged.slide.command.nextSlide",
      "media.paged.slide.command.addComment",
      "media.paged.slide.command.slideShowFromBeginning",
      "media.paged.slide.command.slideShowFromCurrent",
      "media.paged.slide.command.presenterView",
      "media.paged.slide.command.rehearseTimings",
      "media.paged.slide.command.slideSorter",
      "media.paged.slide.command.insertShapes"
    ],
    "importers": ["media.paged.slide.importer.pptx"],
    "exporters": ["media.paged.slide.exporter.pptx"],
    "presentations": ["media.paged.slide.show"],
    "views": ["media.paged.slide.view.sorter"],
    "editContexts": [
      {
        "type": "slideDeck",
        "entry": "doubleClick"
      }
    ],
    "panels": [
      "media.paged.slide.panel.slides",
      "media.paged.slide.panel.notes",
      "media.paged.slide.panel.slide",
      "media.paged.slide.panel.transition",
      "media.paged.slide.panel.placeholder",
      "media.paged.slide.panel.deck",
      "media.paged.slide.panel.comments",
      "media.paged.slide.panel.shapes"
    ],
    "partTypes": [
      {
        "type": "pptx",
        "role": "source",
        "format": "opc",
        "linkable": false
      },
      {
        "type": "slideImport",
        "role": "derived",
        "format": "json"
      }
    ],
    "objectModel": {
      "kinds": [
        {
          "kind": "deck",
          "title": "Deck",
          "schema": "schema/deck.json"
        },
        {
          "kind": "slide",
          "title": "Slide",
          "schema": "schema/slide.json"
        },
        {
          "kind": "layout",
          "title": "Slide layout",
          "schema": "schema/layout.json"
        },
        {
          "kind": "placeholder",
          "title": "Placeholder",
          "schema": "schema/placeholder.json"
        }
      ],
      "commands": [
        {
          "id": "media.paged.slide.newSlide",
          "title": "New slide",
          "args": "schema/new-slide.args.json",
          "result": "schema/new-slide.result.json"
        },
        {
          "id": "media.paged.slide.importPptx",
          "title": "Open a PowerPoint deck",
          "args": "schema/import-pptx.args.json",
          "result": "schema/import-pptx.result.json"
        },
        {
          "id": "media.paged.slide.duplicateSlide",
          "title": "Duplicate slide",
          "args": "schema/duplicate-slide.args.json",
          "result": "schema/duplicate-slide.result.json"
        },
        {
          "id": "media.paged.slide.exportPptx",
          "title": "Export as a PowerPoint deck",
          "args": "schema/export-pptx.args.json",
          "result": "schema/export-pptx.result.json"
        },
        {
          "id": "media.paged.slide.command.addComment",
          "title": "Add a comment",
          "args": "schema/add-comment.args.json",
          "result": "schema/add-comment.result.json"
        },
        {
          "id": "media.paged.slide.command.replyComment",
          "title": "Reply to a comment",
          "args": "schema/reply-comment.args.json",
          "result": "schema/reply-comment.result.json"
        },
        {
          "id": "media.paged.slide.command.resolveComment",
          "title": "Resolve or reopen a comment",
          "args": "schema/resolve-comment.args.json",
          "result": "schema/empty.json"
        },
        {
          "id": "media.paged.slide.command.deleteComment",
          "title": "Delete a comment",
          "args": "schema/delete-comment.args.json",
          "result": "schema/empty.json"
        },
        {
          "id": "media.paged.slide.command.previousSlide",
          "title": "Previous slide",
          "args": "schema/empty.json",
          "result": "schema/empty.json"
        },
        {
          "id": "media.paged.slide.command.nextSlide",
          "title": "Next slide",
          "args": "schema/empty.json",
          "result": "schema/empty.json"
        },
        {
          "id": "media.paged.slide.command.slideShowFromBeginning",
          "title": "Slide show from the beginning",
          "args": {
            "kind": "struct",
            "fields": {}
          },
          "result": {
            "kind": "struct",
            "fields": {
              "presented": {
                "kind": "bool"
              }
            }
          }
        },
        {
          "id": "media.paged.slide.command.slideShowFromCurrent",
          "title": "Slide show from the current slide",
          "args": {
            "kind": "struct",
            "fields": {}
          },
          "result": {
            "kind": "struct",
            "fields": {
              "presented": {
                "kind": "bool"
              }
            }
          }
        },
        {
          "id": "media.paged.slide.command.presenterView",
          "title": "Presenter view",
          "args": {
            "kind": "struct",
            "fields": {}
          },
          "result": {
            "kind": "struct",
            "fields": {
              "presented": {
                "kind": "bool"
              }
            }
          }
        },
        {
          "id": "media.paged.slide.command.rehearseTimings",
          "title": "Rehearse timings",
          "args": {
            "kind": "struct",
            "fields": {}
          },
          "result": {
            "kind": "struct",
            "fields": {
              "presented": {
                "kind": "bool"
              }
            }
          }
        },
        {
          "id": "media.paged.slide.command.slideSorter",
          "title": "Slide sorter",
          "args": {
            "kind": "struct",
            "fields": {}
          },
          "result": {
            "kind": "struct",
            "fields": {
              "presented": {
                "kind": "bool"
              }
            }
          }
        },
        {
          "id": "media.paged.slide.insertShape",
          "title": "Insert a shape",
          "args": "schema/insert-shape.args.json",
          "result": "schema/insert-shape.result.json"
        }
      ],
      "templateFields": [
        {
          "kind": "media.paged.slide.placeholderText",
          "title": "Slide placeholder text"
        },
        {
          "kind": "media.paged.slide.visibility",
          "title": "Slide shown"
        }
      ]
    }
  }
}
