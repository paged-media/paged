      "media.paged.slide.command.animationPane",
      "media.paged.slide.command.previewAnimations",
      "media.paged.slide.command.animationPainter",
      "media.paged.slide.command.insertPicture",
      "media.paged.slide.command.insertIcon",
      "media.paged.slide.command.copyFormat",
      "media.paged.slide.command.pasteFormat",
      "media.paged.slide.command.smartArtText"
    ],
    "importers": ["media.paged.slide.importer.pptx"],
    "exporters": [
      "media.paged.slide.exporter.pptx",
      "media.paged.slide.exporter.potx"
    ],
    "presentations": ["media.paged.slide.show"],
    "views": ["media.paged.slide.view.sorter", "media.paged.slide.view.export"],
    "editContexts": [
      {
        "type": "slideDeck",
        "entry": "doubleClick"
      },
      {
        "type": "slideChart",
        "entry": "doubleClick"
      }
    ],
    "objectTypes": [
      {
        "type": "slideChart",
        "bakedFallback": "group"
      }
    ],
