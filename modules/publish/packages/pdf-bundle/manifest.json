{
  "id": "media.paged.pdf",
  "name": "paged.pdf",
  "version": "0.2.3-canary.0",
  "apiVersion": "^0.2",
  "publisher": "paged.media",
  "capabilities": {
    "document": {
      "read": "broad",
      "openNative": true,
      "write": "scoped"
    },
    "documents": {
      "open": true
    },
    "wasm": [
      {
        "name": "pdf-import",
        "path": "bin/pdf_import_bg.wasm",
        "purpose": "codec",
        "maxBytes": 4194304
      }
    ],
    "assets": ["images"]
  },
  "contributes": {
    "importers": ["media.paged.pdf.importer.pdf"],
    "objectModel": {
      "kinds": [],
      "commands": [
        {
          "id": "media.paged.pdf.importPdf",
          "title": "Open PDF",
          "args": "schema/import-pdf.args.json",
          "result": "schema/import-pdf.result.json"
        },
        {
          "id": "media.paged.pdf.inspectPdf",
          "title": "Inspect PDF or AI file",
          "args": "schema/inspect-pdf.args.json",
          "result": "schema/inspect-pdf.result.json"
        },
        {
          "id": "media.paged.pdf.placeVectors",
          "title": "Place PDF or AI page as vectors",
          "args": "schema/place-vectors.args.json",
          "result": "schema/place-vectors.result.json"
        },
        {
          "id": "media.paged.pdf.convertPlacedToVectors",
          "title": "Convert placed PDF to vectors",
          "args": "schema/convert-placed.args.json",
          "result": "schema/place-vectors.result.json"
        }
      ],
      "templateFields": [
        {
          "kind": "media.paged.pdf.page",
          "title": "PDF page"
        }
      ]
    },
    "commands": ["media.paged.pdf.command.convertPlaced"]
  }
}
