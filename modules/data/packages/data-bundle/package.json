{
  "name": "@paged-media/data",
  "private": false,
  "version": "0.1.0-canary.17",
  "license": "AGPL-3.0-only OR LicenseRef-PMEL",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./manifest.json": "./manifest.json"
  },
  "scripts": {
    "typecheck": "bun check -p tsconfig.json",
    "test": "bun test --parallel --preload ../../../../tooling/js/bun-test-setup.ts --timeout 30000",
    "test:e2e": "bun test --preload ../../../../tooling/js/bun-test-setup.ts --timeout 30000 ./test/pipeline-real.spec.ts ./test/duckdb-real.spec.ts",
    "test:duckdb": "REQUIRE_REAL_DUCKDB=1 bun test --preload ../../../../tooling/js/bun-test-setup.ts --timeout 30000 ./test/duckdb-real.spec.ts",
    "pubcheck": "bun run build && bun ../../scripts/pubcheck.mjs",
    "build": "tsup",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@paged-media/plugin-api": "workspace:*",
    "@paged-media/plugin-sdk": "workspace:*",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@paged-media/canvas-wasm": "workspace:*",
    "@paged-media/data-host-model": "workspace:*",
    "@paged-media/plugin-api": "workspace:*",
    "@paged-media/plugin-sdk": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "apache-arrow": "^17.0.0",
    "playwright-core": "1.63.0",
    "react": "catalog:",
    "typescript": "catalog:",
    "@paged-media/test-kit": "workspace:*",
    "@types/bun": "catalog:"
  },
  "files": [
    "dist",
    "bin/data_js.js",
    "bin/data_js.d.ts",
    "bin/data_js_bg.wasm",
    "bin/data_js_bg.wasm.d.ts",
    "bin/duckdb-engine.wasm",
    "bin/duckdb-browser-eh.worker.js",
    "bin/duckdb-browser.mjs",
    "bin/duckdb-ext/v1.1.1/wasm_eh/json.duckdb_extension.wasm",
    "bin/duckdb-ext/v1.1.1/wasm_eh/parquet.duckdb_extension.wasm",
    "bin/SOURCE_HASH",
    "bin/PACKAGE_HASH",
    "manifest.json"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "canary",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./manifest.json": "./manifest.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paged-media/paged.git",
    "directory": "modules/data/packages/data-bundle"
  }
}
