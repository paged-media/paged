[
  {
    "path": "name",
    "type": {
      "kind": "text"
    },
    "summary": "The layer's name (what a stored binding selects by)."
  },
  {
    "path": "visible",
    "type": {
      "kind": "bool"
    },
    "default": true
  },
  {
    "path": "opacity",
    "type": {
      "kind": "number",
      "unit": "percent"
    },
    "range": {
      "min": 0,
      "max": 100
    },
    "default": 100
  },
  {
    "path": "blendMode",
    "type": {
      "kind": "enum",
      "members": [
        "normal",
        "dissolve",
        "darken",
        "multiply",
        "color_burn",
        "linear_burn",
        "darker_color",
        "lighten",
        "screen",
        "color_dodge",
        "linear_dodge",
        "lighter_color",
        "overlay",
        "soft_light",
        "hard_light",
        "vivid_light",
        "linear_light",
        "pin_light",
        "hard_mix",
        "difference",
        "exclusion",
        "subtract",
        "divide",
        "hue",
        "saturation",
        "color",
        "luminosity"
      ]
    },
    "default": "normal",
    "summary": "A registered compose.* kernel (generated from the kernel registry)."
  },
  {
    "path": "order",
    "type": {
      "kind": "number",
      "integer": true
    },
    "range": {
      "min": 0
    },
    "summary": "Stack position, 0 = bottom."
  },
  {
    "path": "locked",
    "type": {
      "kind": "bool"
    },
    "default": false,
    "summary": "Locks the layer's PIXELS; its properties stay editable."
  },
  {
    "path": "clipped",
    "type": {
      "kind": "bool"
    },
    "default": false,
    "summary": "Clipped to the layer beneath."
  },
  {
    "path": "kind",
    "type": {
      "kind": "enum",
      "members": [
        "pixels",
        "adjustment",
        "smart",
        "fill"
      ]
    },
    "access": "readOnly"
  },
  {
    "path": "fillOpacity",
    "type": {
      "kind": "number",
      "unit": "percent"
    },
    "range": {
      "min": 0,
      "max": 100
    },
    "default": 100,
    "summary": "Fill opacity: the layer's own pixels, apart from its opacity (on the eight special blend modes it acts inside the blend)."
  },
  {
    "path": "knockout",
    "type": {
      "kind": "enum",
      "members": [
        "none",
        "shallow",
        "deep"
      ]
    },
    "default": "none",
    "summary": "Knockout: the layer cuts through the layers beneath it to its group's start (shallow) or to the Background (deep)."
  },
  {
    "path": "colorLabel",
    "type": {
      "kind": "enum",
      "members": [
        "none",
        "red",
        "orange",
        "yellow",
        "green",
        "blue",
        "violet",
        "gray"
      ]
    },
    "default": "none"
  },
  {
    "path": "lockTransparency",
    "type": {
      "kind": "bool"
    },
    "default": false,
    "summary": "Paint, fills and filters keep every pixel's alpha."
  },
  {
    "path": "lockPosition",
    "type": {
      "kind": "bool"
    },
    "default": false
  },
  {
    "path": "lockAll",
    "type": {
      "kind": "bool"
    },
    "default": false,
    "summary": "Pixels, transparency, position and the blending properties."
  },
  {
    "path": "adjustmentKind",
    "type": {
      "kind": "text"
    },
    "access": "readOnly",
    "summary": "An adjustment layer's kind (levels, curves, … ; chain for a stored chain), else absent."
  },
  {
    "path": "fillKind",
    "type": {
      "kind": "text"
    },
    "access": "readOnly",
    "summary": "A fill layer's kind (solid, gradient, pattern), else absent."
  },
  {
    "path": "id",
    "type": {
      "kind": "number",
      "integer": true
    },
    "access": "readOnly",
    "summary": "The engine's stable layer id (a session handle)."
  },
  {
    "path": "hasMask",
    "type": {
      "kind": "bool"
    },
    "access": "readOnly"
  },
  {
    "path": "bounds",
    "type": {
      "kind": "bounds"
    },
    "access": "readOnly",
    "summary": "[top, left, bottom, right] in image pixels."
  },
  {
    "path": "filter",
    "type": {
      "kind": "struct",
      "fields": {
        "params": {
          "kind": "struct",
          "fields": {},
          "open": true
        },
        "region": {
          "kind": "bounds",
          "optional": true
        },
        "mask": {
          "kind": "struct",
          "optional": true,
          "fields": {
            "polygons": {
              "kind": "list",
              "of": {
                "kind": "list",
                "of": {
                  "kind": "point"
                }
              },
              "optional": true
            },
            "ops": {
              "kind": "list",
              "of": {
                "kind": "enum",
                "members": [
                  "add",
                  "subtract",
                  "intersect"
                ]
              },
              "optional": true
            },
            "fillRule": {
              "kind": "enum",
              "members": [
                "nonzero",
                "evenodd"
              ],
              "optional": true
            },
            "alpha": {
              "kind": "bytes",
              "optional": true
            },
            "feather": {
              "kind": "number",
              "optional": true
            }
          }
        },
        "selection": {
          "kind": "bool",
          "optional": true
        }
      }
    },
    "summary": "An action: writing runs a filter on the layer's pixels — `params` are adjustment-layer paths (blur, sharpen, hue, invert, exposure, levels, …) — inside `region` ([top, left, bottom, right] in image pixels; the whole canvas when absent), narrowed by `mask` (a selection as data: `polygons` of [x, y] image pixels, each filled alone and unioned, or with `fillRule` (`evenodd`, `nonzero`) filled together, so an inner polygon cuts a hole; `ops`, one of `add`, `subtract`, `intersect` per polygon, folds the subtract and intersect polygons into the add polygons' shape in order; `alpha`, one coverage byte per canvas pixel or an encoded image of the canvas size, its luminance times its alpha; `feather`, σ px) and, with `selection: true`, by the editor's selection of that frame (the open image's live selection, or the one it kept when the frame closed, resampled when the canvas is the same image at another size; refused where there is none). Partial coverage blends filtered and original pixels. On the GPU where one exists, otherwise on the CPU twins of the same kernels (ADR 465). Reads nothing."
  },
  {
    "path": "pixelSource",
    "type": {
      "kind": "asset"
    },
    "heavy": true,
    "summary": "Pixel replacement (Photoshop's pixel-replacement variable): a data: URL, or the address of a page item whose placed image supplies the pixels. Placed as is, centred. Reads the last source applied."
  }
]
