[
  {
    "path": "width",
    "type": {
      "kind": "number",
      "integer": true
    },
    "access": "readOnly",
    "summary": "Canvas width in image pixels."
  },
  {
    "path": "height",
    "type": {
      "kind": "number",
      "integer": true
    },
    "access": "readOnly",
    "summary": "Canvas height in image pixels."
  },
  {
    "path": "layerCount",
    "type": {
      "kind": "number",
      "integer": true
    },
    "access": "readOnly"
  },
  {
    "path": "revision",
    "type": {
      "kind": "number",
      "integer": true
    },
    "access": "readOnly",
    "summary": "The stored revision the frame's marker points at; 0 = never committed."
  },
  {
    "path": "canvasSize",
    "type": {
      "kind": "struct",
      "fields": {
        "width": {
          "kind": "number",
          "integer": true
        },
        "height": {
          "kind": "number",
          "integer": true
        },
        "anchor": {
          "kind": "enum",
          "members": [
            "topLeft",
            "top",
            "topRight",
            "left",
            "center",
            "right",
            "bottomLeft",
            "bottom",
            "bottomRight"
          ],
          "default": "center"
        }
      }
    },
    "summary": "Canvas Size over every layer: the old canvas sits at `anchor`; added area is transparent. Reads the current size."
  },
  {
    "path": "crop",
    "type": {
      "kind": "bounds"
    },
    "summary": "Crop every layer to [top, left, bottom, right] (image pixels). Reads the whole canvas."
  },
  {
    "path": "transform",
    "type": {
      "kind": "enum",
      "members": [
        "none",
        "rotateCw",
        "rotateCcw",
        "rotate180",
        "flipHorizontal",
        "flipVertical"
      ]
    },
    "default": "none",
    "summary": "An action: writing a quarter turn or a flip transforms every layer; reads none."
  },
  {
    "path": "nextLayerId",
    "type": {
      "kind": "number",
      "integer": true
    },
    "access": "readOnly",
    "summary": "The id the next new layer takes (a session handle), so a batch that creates a layer can address it."
  },
  {
    "path": "pending",
    "type": {
      "kind": "bool"
    },
    "access": "readOnly",
    "summary": "The frame still shows an older composite: this stack needs a GPU realm to bake."
  }
]
