{
  "name": "@paged-media/image",
  "private": false,
  "version": "0.1.0-canary.21",
  "license": "AGPL-3.0-only OR LicenseRef-PMEL",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./decode-worker": "./src/decode-worker.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --parallel --preload ../../../tooling/js/bun-test-setup.ts",
    "build": "tsup",
    "prepublishOnly": "cp ../NOTICE.md ./NOTICE.md && bun run build"
  },
  "peerDependencies": {
    "@paged-media/plugin-api": "workspace:*",
    "@paged-media/plugin-sdk": "workspace:*",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@paged-media/image-manifest": "workspace:*",
    "@paged-media/plugin-api": "workspace:*",
    "@paged-media/plugin-sdk": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "@paged-media/test-kit": "workspace:*",
    "@types/bun": "catalog:",
    "@paged-media/canvas-wasm": "workspace:*"
  },
  "files": [
    "dist",
    "wasm",
    "manifest.json",
    "panels",
    "object-model",
    "NOTICE.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "canary",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./decode-worker": {
        "types": "./dist/decode-worker.d.ts",
        "default": "./dist/decode-worker.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paged-media/paged.git",
    "directory": "modules/image/glue"
  }
}
