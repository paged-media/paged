                "kind": "ref",
                "to": "plugin:media.paged.image/layer"
              },
              "params": {
                "kind": "struct",
                "fields": {},
                "open": true
              },
              "region": {
                "kind": "bounds",
                "optional": true
              },
              "mask": {
                "kind": "struct",
                "optional": true,
                "fields": {
                  "polygons": {
                    "kind": "list",
                    "of": {
                      "kind": "list",
                      "of": {
                        "kind": "point"
                      }
                    },
                    "optional": true
                  },
                  "ops": {
                    "kind": "list",
                    "of": {
                      "kind": "enum",
                      "members": ["add", "subtract", "intersect"]
                    },
                    "optional": true
                  },
                  "fillRule": {
                    "kind": "enum",
                    "members": ["nonzero", "evenodd"],
                    "optional": true
                  },
                  "alpha": {
                    "kind": "bytes",
                    "optional": true
                  },
                  "feather": {
                    "kind": "number",
                    "optional": true
                  }
                }
              },
              "selection": {
                "kind": "bool",
                "optional": true
              }
            }
          }
        },
