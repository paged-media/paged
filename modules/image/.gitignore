# Reference checkouts — third-party material studied during incubation
# (read-only mounts; never committed, never vendored into this repo).
references/

# Rust
/target

# Node
node_modules/
dist/
*.tsbuildinfo

# Optional psd-tools ecosystem-oracle venv (test-only, machine-local)
.venv/

# wasm-bindgen build outputs (scripts/build-wasm.sh, run by
# `moon run image:wasm` and in CI by .github/actions/module-wasm): the copy
# the bundle imports (glue/wasm/, with its SOURCE_HASH stamp) and the one the
# manifest declares (manifest/wasm/image_js_bg.wasm). Not committed: the
# typecheck, the specs and wasm-fresh.spec.ts read the one built from this
# checkout.
glue/wasm/image_js*
glue/wasm/SOURCE_HASH
manifest/wasm/*.wasm
manifest/wasm/*.js
manifest/wasm/*.d.ts

# copied from the repo-root NOTICE.md by glue prepublishOnly (IJG attribution
# must ship in the npm tarball alongside the wasm it applies to)
glue/NOTICE.md
