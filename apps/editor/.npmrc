# Workspace deps resolve through symlinks (default for pnpm); this
# pin guards against environment overrides.
link-workspace-packages=true
prefer-workspace-packages=true
# Stay strict about phantom deps — fail builds when a package
# imports something not in its own package.json.
strict-peer-dependencies=false
auto-install-peers=true

# ─── DRY-RUN ONLY (Decision-B package-boundary spike) ─────────────────
# Scope the @paged-media wasm/SDK packages to a LOCAL Verdaccio registry
# so `pnpm install` resolves the dry-run `0.33.0-dry.0` tarballs instead
# of hitting npmjs.org. REMOVE / REPOINT at flip time: replace the URL
# with the real registry (https://registry.npmjs.org/ — the public npm
# org default) and drop this whole block once the packages are public.
@paged-media:registry=http://localhost:4873/
