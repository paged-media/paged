# Cross-origin isolation for SharedArrayBuffer (W0.17).
#
# The render worker allocates a SharedArrayBuffer for the camera + gesture
# transforms. `new SharedArrayBuffer(...)` throws SecurityError unless the
# page is cross-origin isolated, which requires BOTH of these response
# headers on the top-level document (and COEP on every subresource —
# require-corp makes the browser refuse any resource that doesn't opt in).
#
# Format: Netlify / Cloudflare Pages `_headers`. Vite copies files under
# `public/` verbatim to the dist root, so this ships as `dist/_headers`.
# The dev server sets the same two headers via the `crossOriginIsolation`
# plugin in vite.config.ts; keep them in lock-step.
#
# nginx equivalent (for a self-hosted static deploy) — add inside the
# `server { ... }` (or the SPA `location / { ... }`) block:
#
#     add_header Cross-Origin-Opener-Policy   "same-origin"   always;
#     add_header Cross-Origin-Embedder-Policy "require-corp"  always;
#     # the .wasm asset must be served with the right type so the
#     # streaming-compile path (WebAssembly.instantiateStreaming) works:
#     types { application/wasm wasm; }
#
# Apache equivalent (.htaccess):
#     Header always set Cross-Origin-Opener-Policy   "same-origin"
#     Header always set Cross-Origin-Embedder-Policy "require-corp"

/*
  Cross-Origin-Opener-Policy: same-origin
  # `credentialless` (not `require-corp`) so this app can be embedded as a
  # cross-origin <iframe> by the docs scripting playground (docs.paged.media ships
  # COEP: credentialless, and Chrome will not nest a `require-corp` document inside
  # a `credentialless` one — the modes must match). Both values yield
  # crossOriginIsolated === true, so SharedArrayBuffer still works; credentialless
  # just loads any cross-origin subresource without credentials instead of
  # requiring CORP. (The enforced CSP below bounds script-initiated requests
  # only; an element may still load a cross-origin subresource, which then
  # arrives without credentials.) Lock-step with the dev header in
  # apps/canvas/vite.config.ts.
  Cross-Origin-Embedder-Policy: credentialless
  # Allow this document to be embedded as a cross-origin <iframe> by the docs
  # scripting playground. A COEP parent (docs.paged.media) blocks a cross-origin
  # iframe with ERR_BLOCKED_BY_RESPONSE unless the embedded document opts in with
  # CORP — without this the iframe shows "refused to connect". `cross-origin` (vs
  # `same-site`) keeps the open playground embeddable from anywhere.
  Cross-Origin-Resource-Policy: cross-origin
  # D-03 network wall — bound every SCRIPT-INITIATED request of the page and
  # its workers (fetch, XHR, WebSocket, EventSource, sendBeacon) to same-origin,
  # local bytes and the module host (ADR 220: the deployed build's wasm
  # redirects there). Every first-party bundle declares `network: false`, so
  # the consented set is empty. `connect-src` only — no `default-src` — so this
  # line does NOT bound what elements load: an `<img>`, a stylesheet, a font,
  # a media element, a script element or a frame can still name another
  # origin. The policy that bounds those is the report-only line further down.
  # Lock-step with the dev header in apps/canvas/vite.config.ts. This must stay
  # the FIRST Content-Security-Policy line: the build's rewrite replaces it.
  Content-Security-Policy: connect-src 'self' blob: data: https://modules.paged.media
  # ADR 240, ADR 273 — Trusted Types, ENFORCED: a string reaching an HTML,
  # script or script-URL sink without a policy is refused, and the violation
  # is reported to the Pages Function at /api/csp-report. A policy of its own
  # (a second Content-Security-Policy line; Pages joins the two with a comma,
  # and the browser enforces both), so the build's connect-src rewrite above
  # never touches it. The value is src/boot/trusted-types.ts's
  # TRUSTED_TYPES_POLICY (the dev server sends it from there;
  # scripts/trusted-types.test.mjs keeps the two equal).
  Content-Security-Policy: require-trusted-types-for 'script'; report-uri /api/csp-report
  # The resource policy, REPORT-ONLY: nothing is blocked by it yet; each
  # violation is posted to /api/csp-report. It states what the editor is known
  # to load, so the reports show what an enforced policy would break before it
  # is enforced (and the dev server does not send it yet).
  #   default-src  same-origin for everything not named below
  #   script-src   the editor's own scripts, blob: workers and glue, the module
  #                host; 'wasm-unsafe-eval' compiles the engines' wasm;
  #                'unsafe-eval' is the scripting playground's `new Function`,
  #                whose source Trusted Types (above) must approve
  #   worker-src   the editor's workers, by URL or from a blob
  #   style-src    'unsafe-inline': the entry page's <style>, style attributes,
  #                and the sandboxed web preview (a srcdoc frame inherits this
  #                policy and carries its own stricter one)
  #   img/font/media-src  same-origin, blob: and data: (document bytes)
  #   connect-src  the wall above, restated so default-src does not narrow it;
  #                a build that admits data origins rewrites only the enforced
  #                line, so those origins are reported here
  #   frame-src    embed.html in the embedding demo
  #   object-src 'none', base-uri 'self', form-action 'self'
  # Known report: oauth-callback.html runs an inline script, which script-src
  # here does not admit; it moves to a file before this policy is enforced.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' blob: https://modules.paged.media; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' blob: data:; media-src 'self' blob: data:; connect-src 'self' blob: data: https://modules.paged.media; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; report-uri /api/csp-report

# Embedding plan E6 — embed.html is the editor a host drives through an
# iframe. Which pages may frame it is a deploy-time list: the floor is the
# editor's own origin, and a build with VITE_EMBED_ORIGINS (comma-separated
# https origins) widens it in the output's copy (vite.config.ts
# `embedFrameAncestors`). The bridge checks every message against the same
# list (src/embed/protocol.ts `embedOrigins`).
/embed.html
  Content-Security-Policy: frame-ancestors 'self'
