{
  "name": "paged-canvas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bun check && bunx --bun vite build",
    "build:demo": "bun check && bunx --bun vite build --mode demo --outDir dist-demo",
    "preview": "bunx --bun vite preview",
    "typecheck": "bun check -p tsconfig.json && bun check -p functions/tsconfig.json && bun check -p test/tsconfig.json",
    "typecheck:tests": "bun check -p tsconfig.tests.json",
    "test:contracts": "bun test --preload ../../../../tooling/js/bun-test-setup.ts ./test/contracts",
    "test:fidelity": "playwright test --config=playwright.config.ts",
    "test:journeys": "playwright test --project=journeys",
    "test:journeys:gpu": "playwright test --project=journeys-gpu",
    "test:fidelity:capture": "FIDELITY_MODE=capture playwright test --config=playwright.config.ts",
    "test:fidelity:ui": "playwright test --config=playwright.config.ts --ui",
    "test:fidelity:dashboard": "open ${FIDELITY_OUT:-/tmp/paged-canvas-fidelity}/dashboard.html",
    "test:fidelity:report": "playwright show-report",
    "fonts:list": "tsx scripts/fonts-resolve.ts --list",
    "fonts:resolve": "tsx scripts/fonts-resolve.ts",
    "typecheck:showcase": "bun check -p tests/showcase/tsconfig.json",
    "showcase:indesign-render": "playwright test --project=showcase --grep \"InDesign render\"",
    "showcase:indesign-render:capture": "SHOWCASE_RENDER_MODE=capture playwright test --project=showcase --grep \"InDesign render\""
  },
  "dependencies": {
    "@paged-media/ai": "workspace:*",
    "@paged-media/canvas-wasm": "workspace:*",
    "@paged-media/catalog": "workspace:*",
    "@paged-media/client": "workspace:*",
    "@paged-media/data": "workspace:*",
    "@paged-media/doc": "workspace:*",
    "@paged-media/slide": "workspace:*",
    "@paged-media/draw": "workspace:*",
    "@paged-media/image": "workspace:*",
    "@paged-media/pdf": "workspace:*",
    "@paged-media/plugin-api": "workspace:*",
    "@paged-media/plugin-sdk": "workspace:*",
    "@paged-media/publish": "workspace:*",
    "@paged-media/repository": "workspace:*",
    "@paged-media/sheet": "workspace:*",
    "@paged-media/shell": "workspace:*",
    "@paged-media/tools": "workspace:*",
    "@paged-media/ui": "workspace:*",
    "@paged-media/web": "workspace:*",
    "apache-arrow": "^17.0.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "catalog:",
    "@types/node": "catalog:node25",
    "@types/pngjs": "^6.0.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
