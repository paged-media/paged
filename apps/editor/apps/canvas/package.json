{
  "name": "paged-canvas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo --outDir dist-demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src vite.config.ts",
    "test:fidelity": "playwright test --config=playwright.config.ts",
    "test:fidelity:capture": "FIDELITY_MODE=capture playwright test --config=playwright.config.ts",
    "test:fidelity:ui": "playwright test --config=playwright.config.ts --ui",
    "test:fidelity:dashboard": "open ${FIDELITY_OUT:-/tmp/paged-canvas-fidelity}/dashboard.html",
    "test:fidelity:report": "playwright show-report",
    "fonts:list": "tsx scripts/fonts-resolve.ts --list",
    "fonts:resolve": "tsx scripts/fonts-resolve.ts"
  },
  "dependencies": {
    "@paged-media/canvas-wasm": "0.51.0",
    "@paged-media/catalog": "workspace:*",
    "@paged-media/client": "workspace:*",
    "@paged-media/data-bundle": "0.1.0-canary.0",
    "@paged-media/draw-bundle": "0.2.0-canary.0",
    "@paged-media/image-glue": "0.0.1-canary.0",
    "@paged-media/plugin-api": "0.2.25-canary.0",
    "@paged-media/plugin-sdk": "0.2.25-canary.0",
    "@paged-media/sheet-bundle": "0.1.0-canary.0",
    "@paged-media/shell": "workspace:*",
    "@paged-media/tools": "workspace:*",
    "@paged-media/ui": "workspace:*",
    "@paged-media/web-bundle": "0.1.0-canary.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "apache-arrow": "^17.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "rrweb": "2.0.1"
  }
}
