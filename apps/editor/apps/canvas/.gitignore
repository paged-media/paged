# (legacy bridge) drops output here on a dev machine.
src/wasm/
*.local
tsconfig.tsbuildinfo
playwright-report/
test-results/

# demo-capture rrweb session output (uploaded as release assets, not committed)
apps/canvas/tests/demo/out/

# demo/playground build output (deployed to the playground host, not committed)
dist-demo/

# ad-hoc real-world PDF test documents (manual paged.pdf testing; some are
# personal/third-party — never commit). The committed fixtures are
# public/sample.pdf + public/report.pdf.
public/pdfs/

# annual/showcase build state: per-chapter checkpoints + ledger fragments are
# reproducible run intermediates; the committed artifacts live in showcase/ root
showcase/checkpoints/
showcase/ledger/
# full-res per-page renders at annual scale are CI artifacts, not commits;
# the committed page evidence is the contact sheet (WP5)
showcase/pages/
