{
  "name": "@paged-media/client",
  "version": "0.63.0-canary.0",
  "type": "module",
  "description": "The programmable Paged SDK: a CanvasClient over the @paged-media/canvas-wasm engine — load, mutate, read, render and export a document from code, with the same wire the editor uses.",
  "license": "AGPL-3.0-only OR LicenseRef-PMEL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paged-media/editor.git",
    "directory": "packages/client"
  },
  "homepage": "https://paged.media",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sab/*": "./src/sab/*.ts",
    "./journal": "./src/journal/index.ts",
    "./api-catalog.json": "./api-catalog.json"
  },
  "files": [
    "dist",
    "api-catalog.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "canary",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./sab/*": {
        "types": "./dist/sab/*.d.ts",
        "default": "./dist/sab/*.js"
      },
      "./journal": {
        "types": "./dist/journal/index.d.ts",
        "default": "./dist/journal/index.js"
      },
      "./api-catalog.json": "./api-catalog.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "catalog": "node ../../scripts/client-api-catalog.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@paged-media/canvas-wasm": "0.63.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
