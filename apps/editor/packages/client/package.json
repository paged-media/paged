{
  "name": "@paged-media/client",
  "version": "0.64.0-canary.0",
  "private": true,
  "type": "module",
  "description": "The programmable Paged SDK: a CanvasClient over the @paged-media/canvas-wasm engine — load, mutate, read, render and export a document from code, with the same wire the editor uses.",
  "license": "AGPL-3.0-only OR LicenseRef-PMEL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paged-media/paged.git",
    "directory": "apps/editor/packages/client"
  },
  "homepage": "https://paged.media",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sab/*": "./src/sab/*.ts",
    "./journal": "./src/journal/index.ts",
    "./api-catalog.json": "./api-catalog.json"
  },
  "scripts": {
    "catalog": "bun ../../scripts/client-api-catalog.mjs",
    "typecheck": "bun check -p tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@paged-media/canvas-wasm": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
