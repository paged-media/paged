{
  "name": "@paged-media/shell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./state/*": "./src/state/*.ts",
    "./state/*.tsx": "./src/state/*.tsx",
    "./tailwind.config": "./tailwind.config.ts",
    "./styles/globals.css": "./src/styles/globals.css",
    "./styles/theme.css": "./src/styles/theme.css"
  },
  "scripts": {
    "typecheck": "bun check -p tsconfig.json && bun check -p test/tsconfig.json",
    "test": "bun test --parallel --timeout 30000 --preload ../../../../tooling/js/bun-test-setup.ts --path-ignore-patterns '**/*.dom.test.*'",
    "test:dom": "bun test --parallel --timeout 30000 --preload ../../../../tooling/js/bun-test-setup.ts --preload ./test/happydom.ts .dom.test."
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@paged-media/ai": "workspace:*",
    "@paged-media/catalog": "workspace:*",
    "@paged-media/client": "workspace:*",
    "@paged-media/plugin-api": "workspace:*",
    "@paged-media/repository": "workspace:*",
    "@paged-media/ui": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@paged-media/test-kit": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "autoprefixer": "^10.5.5",
    "happy-dom": "catalog:",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "catalog:"
  }
}
