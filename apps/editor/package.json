{
  "name": "paged-monorepo",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only OR LicenseRef-PMEL",
  "scripts": {
    "typecheck": "bun run --filter './apps/*' typecheck",
    "build": "bun run --filter './apps/*' build",
    "wasm": "bun run --filter './apps/*' wasm",
    "test:boot-coi": "bun test --timeout 30000 ./scripts/cross-origin-isolation-check.test.mjs",
    "test:network-policy": "bun test --timeout 30000 ./scripts/network-policy.test.mjs",
    "test:modules": "bun test --timeout 30000 ./scripts/modules.test.mjs",
    "test:spread-pages": "bun test --timeout 30000 ./scripts/spread-pages.test.mjs",
    "test:repository": "bun run --filter ./packages/repository test",
    "test:tools": "bun run --filter ./packages/tools test",
    "test:shell": "bun run --filter ./packages/shell test",
    "test:shell-dom": "bun run --filter ./packages/shell test:dom",
    "test:canvas-unit": "bun run --filter ./apps/canvas test:unit",
    "test:dom": "bun run --filter ./apps/canvas test:dom",
    "test:thresholds": "bun test --timeout 30000 ./scripts/fidelity-thresholds-schema.test.mjs",
    "test:journal": "bun test --timeout 30000 ./scripts/journal.test.mjs",
    "test:object-model": "bun test --timeout 30000 ./scripts/object-model.test.mjs",
    "test:wasm-budget": "bun scripts/wasm-budget.mjs",
    "test:surface-coverage": "bun test --timeout 30000 ./scripts/surface-coverage.test.mjs && bun scripts/surface-coverage.mjs",
    "test:headless": "bun run --filter ./apps/canvas test:headless",
    "test:seam-guard": "bun scripts/seam-guard.mjs",
    "test:applicability": "bun scripts/applicability-guard.mjs",
    "test:feat-vocabulary": "bun scripts/feat-vocabulary-guard.mjs",
    "test:quarantine": "bun test --timeout 30000 ./scripts/quarantine-guard.test.mjs && bun scripts/quarantine-guard.mjs --list",
    "test:solo-profiles": "bun scripts/solo-profiles-guard.mjs",
    "test:client-catalog": "bun scripts/client-api-catalog.mjs --check"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8"
  }
}
