{
  "name": "paged-monorepo",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only OR LicenseRef-PMEL",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "typecheck": "pnpm -r --filter=./apps/* run typecheck",
    "build": "pnpm -r --filter=./apps/* run build",
    "wasm": "pnpm -r --filter=./apps/* run wasm",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:boundaries-selftest": "node scripts/eslint-boundaries-selftest.mjs",
    "test:boot-coi": "node --experimental-strip-types scripts/cross-origin-isolation-check.test.mjs",
    "test:thresholds": "node scripts/fidelity-thresholds-schema.test.mjs",
    "test:journal": "node --experimental-strip-types scripts/journal.test.mjs",
    "test:wasm-budget": "node scripts/wasm-budget.mjs",
    "check:pins": "node scripts/check-plugin-pins.mjs",
    "test:surface-coverage": "node scripts/surface-coverage.mjs",
    "test:seam-guard": "node scripts/seam-guard.mjs",
    "test:applicability": "node scripts/applicability-guard.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "globals": "15.15.0",
    "typescript-eslint": "8.60.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "@paged-media/doc": "link:../plugins/plugin-doc/packages/doc-bundle"
    }
  }
}
