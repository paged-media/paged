    "catalog": {
      "@types/bun": "1.4.3",
      "@types/node": "^24.19.2",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "typescript": "^7.0.2",
      "vite": "^8.3.4"
    }
  },
  "overrides": {
    "tsx": {
      "esbuild": "^0.28.1"
    }
  }
